# Copy to .env (git-ignored) and fill in. Never commit real values.
SPRING_PROFILES_ACTIVE=dev
PORT=8081

# JDBC format, NOT the postgres:// URL some platforms show.
# Docker maps container port 5432 to host port 5433 (a Windows PostgreSQL may already use 5432).
DATABASE_URL=jdbc:postgresql://localhost:5433/ecommerce_dev
DATABASE_USERNAME=ecommerce
DATABASE_PASSWORD=change-me
POSTGRES_DB=ecommerce_dev

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT (Phase 2). Secret must be at least 32 characters. Generate one (PowerShell):
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# Used by later phases
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
