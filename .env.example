# Copy to .env (git-ignored) and fill in. Never commit real values.
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# JDBC format, NOT the postgres:// URL some platforms show
DATABASE_URL=jdbc:postgresql://localhost:5432/ecommerce_dev
DATABASE_USERNAME=ecommerce
DATABASE_PASSWORD=change-me
POSTGRES_DB=ecommerce_dev

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Used by later phases (kept here so the file stays the single source of truth)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=
JWT_ACCESS_EXPIRATION=
JWT_REFRESH_EXPIRATION=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
